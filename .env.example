# Local backend is the default in development.
# For a production frontend, set this before running npm run build.
# Use your hosted HTTPS API origin, without a trailing /api.
REACT_APP_API_URL=http://localhost:5000

# Use this frontend value when Express serves the production build:
# REACT_APP_API_URL=same-origin
# Backend environment variables (set in the hosting dashboard):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/inotebook
# JWT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# FRONTEND_URL=https://your-separate-frontend.example.com
